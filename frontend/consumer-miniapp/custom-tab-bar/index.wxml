<view class="tab-shell">
  <view class="tab-card">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="icon-wrap">
        <image class="tab-icon" src="{{item.iconPath}}" mode="aspectFit" />
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>

.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 10rpx 24rpx calc(env(safe-area-inset-bottom) + 12rpx);
  background: linear-gradient(180deg, rgba(246, 248, 251, 0), rgba(246, 248, 251, 0.92) 28%, #ffffff 100%);
  box-sizing: border-box;
}

.tab-card {
  height: 108rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 34rpx;
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.12);
  box-sizing: border-box;
}

.tab-item {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 26rpx;
  color: #667085;
  transition: background-color 0.18s ease, color 0.18s ease;
}

.tab-item.active {
  background: #eef6ff;
  color: #1677ff;
}

.tab-item.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 28rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #1677ff;
  transform: translateX(-50%);
}

.icon-wrap {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
}

.tab-text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

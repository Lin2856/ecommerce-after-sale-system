<view class="page">
  <view class="hero">
    <view>
      <view class="title">绑定电商平台账号</view>
    </view>
    <view class="hero-badge">本地平台 {{localPlatforms.length}}</view>
  </view>

  <view class="section-head">
    <view>
      <view class="section-title">开放平台</view>
    </view>
  </view>

  <view class="platform-grid compact-platform-grid">
    <view
      wx:for="{{openPlatforms}}"
      wx:key="name"
      class="platform-card"
      bindtap="bindPlatform"
      data-name="{{item.name}}"
    >
      <image class="platform-icon small-icon" src="{{item.icon}}" mode="aspectFill" />
      <view class="platform-name">{{item.name}}</view>
      <view class="platform-status">{{item.status}}</view>
    </view>
  </view>

  <view class="section-head twenty-head">
    <view>
      <view class="section-title">本地模拟平台</view>
    </view>
  </view>

  <view wx:for="{{localPlatforms}}" wx:key="code" class="twenty-card">
    <view class="twenty-main">
      <view class="twenty-logo-wrap">
        <image class="twenty-logo" src="{{item.icon}}" mode="aspectFit" />
      </view>
      <view class="twenty-info">
        <view class="twenty-title-row">
          <view>
            <view class="twenty-title">{{item.name}}</view>
            <view class="twenty-subtitle">本地数据库模拟平台</view>
          </view>
          <view class="twenty-status {{item.boundCount ? 'status-bound' : ''}}">{{item.boundCount ? '已绑定' : '未绑定'}}</view>
        </view>
      </view>
    </view>
    <button class="bind-btn" bindtap="bindPlatform" data-name="{{item.name}}" data-code="{{item.code}}">继续绑定</button>

    <view class="bound-panel">
      <view class="bound-title-row">
        <view>
          <view class="bound-title">已绑定账号</view>
        </view>
        <view class="bound-count">{{item.boundCount}}</view>
      </view>
      <view wx:if="{{item.boundCount}}" class="bound-list">
        <view wx:for="{{item.bindings}}" wx:for-item="binding" wx:key="accountNo" class="bound-account">
          <view class="account-mark">{{item.code === 'YUEGOU_MARKET' ? '悦' : '万'}}</view>
          <view class="account-info">
            <text>{{binding.accountNo}}</text>
          </view>
          <button class="unbind-btn" catchtap="unbindLocalPlatform" data-code="{{item.code}}" data-account="{{binding.accountNo}}">解绑</button>
        </view>
      </view>
      <view wx:else class="empty-bind">绑定后，这里会展示对应平台账号。</view>
    </view>
  </view>

  <view wx:if="{{selfBuiltDialogVisible}}" class="dialog-mask">
    <view class="dialog">
      <view class="sub-title">绑定{{selectedPlatformName}}账号</view>
      <view class="muted">请输入对应平台的消费者二级账号和密码</view>
      <input class="dialog-input" placeholder="请输入{{selectedPlatformName}}账号" value="{{selfBuiltAccount}}" bindinput="onSelfBuiltAccountInput" />
      <input class="dialog-input" password placeholder="请输入密码" value="{{selfBuiltPassword}}" bindinput="onSelfBuiltPasswordInput" />
      <view class="dialog-actions">
        <button class="cancel-btn" bindtap="closeSelfBuiltDialog">取消</button>
        <button class="confirm-btn" bindtap="submitSelfBuiltBind">确认绑定</button>
      </view>
    </view>
  </view>
</view>

.page {
  min-height: 100vh;
  padding-bottom: 28rpx;
  background: #f4f7fb;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 18rpx 0 18rpx;
  padding: 30rpx;
  border: 1rpx solid #e6edf7;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.04);
}

.title {
  color: #0f172a;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
}

.muted {
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}

.hero-badge {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 2rpx 12rpx;
}

.section-title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 800;
}

.twenty-head {
  margin-top: 24rpx;
}

.platform-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx 0;
}

.platform-card {
  width: 23.5%;
  min-height: 168rpx;
  padding: 20rpx 8rpx;
  border: 1rpx solid #e6edf7;
  border-radius: 20rpx;
  background: #ffffff;
  box-sizing: border-box;
  text-align: center;
}

.platform-card:active,
.twenty-card:active {
  transform: scale(0.99);
}

.platform-icon {
  width: 82rpx;
  height: 82rpx;
  overflow: hidden;
  background: #f2f4f7;
}

.small-icon {
  border-radius: 22rpx;
}

.platform-name {
  margin-top: 14rpx;
  color: #0f172a;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
}

.platform-status {
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.twenty-card {
  padding: 24rpx;
  border: 1rpx solid #dbe8f8;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.05);
}

.twenty-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.twenty-logo-wrap {
  display: grid;
  place-items: center;
  width: 106rpx;
  height: 106rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: #f8fafc;
}

.twenty-logo {
  width: 90rpx;
  height: 90rpx;
}

.twenty-info {
  flex: 1;
  min-width: 0;
}

.twenty-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.twenty-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 900;
}

.twenty-subtitle {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 25rpx;
}

.twenty-status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 700;
}

.status-bound {
  background: #ecfdf3;
  color: #16a34a;
}

.bind-btn {
  width: 100%;
  height: 78rpx;
  line-height: 78rpx;
  margin: 22rpx 0 0;
  border-radius: 16rpx;
  background: #1f7ae0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.bound-panel {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2f7;
}

.bound-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.bound-title {
  color: #334155;
  font-size: 26rpx;
  font-weight: 800;
}

.bound-count {
  display: grid;
  place-items: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #eff6ff;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 800;
}

.bound-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.bound-account {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 76rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  background: #f8fbff;
  color: #0f172a;
  font-size: 26rpx;
}

.account-mark {
  display: grid;
  place-items: center;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: #dbeafe;
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 900;
}

.account-info {
  flex: 1;
  min-width: 0;
}

.account-info text {
  display: block;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 800;
}

.unbind-btn {
  width: 104rpx;
  height: 52rpx;
  line-height: 52rpx;
  margin: 0;
  border-radius: 12rpx;
  background: #fff1f0;
  color: #d92d20;
  font-size: 22rpx;
}

.empty-bind {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #94a3b8;
  font-size: 24rpx;
  text-align: center;
}

.dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.36);
  padding: 40rpx;
  box-sizing: border-box;
}

.dialog {
  width: 100%;
  border-radius: 24rpx;
  background: #fff;
  padding: 34rpx;
  box-sizing: border-box;
}

.sub-title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 800;
}

.dialog-input {
  height: 86rpx;
  border: 1rpx solid #d8e1ef;
  border-radius: 14rpx;
  padding: 0 22rpx;
  margin-top: 18rpx;
  box-sizing: border-box;
  background: #f8fafc;
}

.dialog-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.cancel-btn {
  background: #f2f4f7;
  color: #344054;
}

.confirm-btn {
  background: #1f7ae0;
  color: #fff;
}

.dialog-mask {
  background: rgba(15, 23, 42, 0.52);
  backdrop-filter: blur(8rpx);
}

.dialog {
  padding: 38rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  border-radius: 30rpx;
  box-shadow: 0 30rpx 80rpx rgba(15, 23, 42, 0.18);
}

.dialog::before {
  content: "";
  display: block;
  width: 72rpx;
  height: 8rpx;
  margin: -10rpx auto 26rpx;
  border-radius: 999rpx;
  background: #dbe3ef;
}

.dialog-input {
  height: 92rpx;
  border-color: #dbe3ef;
  border-radius: 18rpx;
  background: #fbfdff;
  color: #0f172a;
  font-size: 28rpx;
}

.cancel-btn,
.confirm-btn {
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 18rpx;
  font-weight: 800;
}

.cancel-btn {
  background: #f8fafc;
  color: #334155;
}

.confirm-btn {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  box-shadow: 0 12rpx 24rpx rgba(37, 99, 235, 0.22);
}

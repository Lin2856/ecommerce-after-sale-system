.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 150rpx;
  background: #f4f7fb;
}

.page-title {
  margin: 8rpx 0 20rpx;
  color: #0f172a;
  font-size: 40rpx;
  font-weight: 900;
}

.filter-tabs {
  position: sticky;
  top: 0;
  z-index: 3;
  display: flex;
  gap: 8rpx;
  margin: 0 0 18rpx;
  padding: 8rpx;
  border: 1rpx solid #e6edf7;
  border-radius: 18rpx;
  background: rgba(237, 242, 248, 0.96);
  backdrop-filter: blur(10rpx);
}

.filter-tab {
  flex: 1;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 14rpx;
  color: #64748b;
  font-size: 25rpx;
  font-weight: 800;
}

.filter-tab.active {
  color: #0f172a;
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.07);
}

.source-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 14rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 18rpx;
  background: #eff6ff;
}

.source-title {
  color: #1d4ed8;
  font-size: 28rpx;
  font-weight: 900;
}

.source-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.source-icon {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(37, 99, 235, 0.16);
}

.source-account {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 23rpx;
}

.source-count {
  display: grid;
  place-items: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #2563eb;
  font-size: 25rpx;
  font-weight: 900;
}

.shop-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 18rpx 2rpx 12rpx;
}

.shop-dot {
  width: 8rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: #2563eb;
}

.shop-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-card {
  display: flex;
  margin-bottom: 16rpx;
  padding: 16rpx;
  border: 1rpx solid #e6edf7;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.035);
}

.order-card:active {
  transform: scale(0.99);
}

.product-thumb {
  width: 144rpx;
  height: 144rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: #eaf2ff;
}

.order-info {
  flex: 1;
  min-width: 0;
}

.between {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.order-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price {
  flex-shrink: 0;
  color: #2563eb;
  font-size: 29rpx;
  font-weight: 900;
}

.spec-line {
  max-width: 390rpx;
  margin-top: 10rpx;
  overflow: hidden;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
}

.after-sale-tag {
  display: inline-flex;
  align-items: center;
  max-width: 250rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 800;
}

.after-sale-tag.warning {
  background: #fff7ed;
  color: #ea580c;
}

.after-sale-tag.success {
  background: #ecfdf3;
  color: #16a34a;
}

.after-sale-tag.plain {
  background: #f1f5f9;
  color: #64748b;
}

.detail-link {
  flex-shrink: 0;
  color: #2563eb;
  font-size: 25rpx;
  font-weight: 900;
}

.detail-link::after {
  content: "›";
  margin-left: 6rpx;
  font-size: 30rpx;
  line-height: 1;
}

.order-no {
  margin-top: 10rpx;
  overflow: hidden;
  color: #94a3b8;
  font-size: 21rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-card {
  padding: 42rpx 28rpx;
  border: 1rpx solid #eef2f7;
  border-radius: 20rpx;
  background: #ffffff;
  text-align: center;
}

.empty-title {
  margin-bottom: 12rpx;
  color: #101828;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-text {
  margin-bottom: 28rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-btn {
  width: 220rpx;
  border-radius: 14rpx;
  background: #1f7ae0;
  color: #ffffff;
  font-size: 28rpx;
}

.empty-mini {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #eef2f7;
  border-radius: 16rpx;
  background: #ffffff;
  color: #667085;
}

.page {
  min-height: 100vh;
  padding: 82rpx 40rpx 40rpx;
  background: linear-gradient(180deg, #eef5ff 0%, #f6f8fb 42%, #f6f8fb 100%);
  box-sizing: border-box;
}

.login-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 34rpx 10rpx 42rpx;
}

.brand-icon {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(31, 122, 224, 0.24);
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 700;
}

.login-card {
  padding: 34rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e6edf7;
  box-shadow: 0 18rpx 46rpx rgba(15, 23, 42, 0.07);
  box-sizing: border-box;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.title {
  margin: 0;
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
}

.muted {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.45;
}

.secure-badge {
  flex-shrink: 0;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf3;
  color: #16a34a;
  font-size: 23rpx;
  font-weight: 800;
}

.demo-box {
  margin-top: 26rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f8fbff;
  border: 1rpx solid #e7eef8;
}

.demo-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 42rpx;
}

.demo-row + .demo-row {
  margin-top: 10rpx;
}

.demo-label {
  flex-shrink: 0;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 700;
}

.demo-value {
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 800;
  text-align: right;
}

.form-area {
  margin-top: 26rpx;
}

.input-wrap {
  padding: 18rpx 22rpx;
  border: 1rpx solid #d8e4f3;
  border-radius: 20rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.input-wrap + .input-wrap {
  margin-top: 18rpx;
}

.code-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.code-input-main {
  flex: 1;
  min-width: 0;
}

.input-label {
  display: block;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 800;
}

.input {
  width: 100%;
  height: 54rpx;
  margin-top: 4rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
}

.code-btn {
  width: 188rpx;
  height: 60rpx;
  line-height: 60rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 800;
}

.code-btn-disabled {
  background: #f1f5f9;
  color: #94a3b8;
}

.primary-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 28rpx 0 0;
  border-radius: 18rpx;
  background: #1f7ae0;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 28rpx rgba(31, 122, 224, 0.22);
}

.divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 26rpx 0 18rpx;
  color: #94a3b8;
  font-size: 23rpx;
}

.divider view {
  flex: 1;
  height: 1rpx;
  background: #e8eef6;
}

.wechat-btn {
  height: 84rpx;
  line-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 0;
  border: 1rpx solid #bfe6c7;
  border-radius: 18rpx;
  background: #f8fff9;
  color: #15913a;
  font-size: 29rpx;
  font-weight: 800;
}

.wechat-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 10rpx;
}

.avatar-auth-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.58);
}

.avatar-auth-sheet {
  width: 100%;
  padding: 38rpx 30rpx 44rpx;
  border-radius: 18rpx 18rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.avatar-auth-app {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #0f172a;
  font-size: 26rpx;
}

.avatar-auth-brand {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  opacity: 0.55;
}

.avatar-auth-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar-auth-action {
  flex-shrink: 0;
}

.avatar-auth-title {
  margin-top: 34rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 500;
}

.avatar-auth-line {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #eef2f7;
  border-bottom: 1rpx solid #eef2f7;
}

.avatar-auth-preview {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #eef2f7;
}

.avatar-auth-empty {
  border: 1rpx dashed #cbd5e1;
}

.avatar-auth-text {
  flex: 1;
  min-width: 0;
}

.avatar-auth-label {
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 700;
}

.avatar-auth-desc {
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.avatar-auth-choose {
  width: 110rpx;
  height: 56rpx;
  line-height: 56rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
}

.avatar-auth-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 42rpx;
}

.avatar-auth-cancel,
.avatar-auth-confirm {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  margin: 0;
  border-radius: 6rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.avatar-auth-cancel {
  background: #f7f7f7;
  color: #16a34a;
}

.avatar-auth-confirm {
  background: #07c160;
  color: #ffffff;
}

.avatar-auth-disabled {
  background: #b7ebc9;
  color: #ffffff;
}

.avatar-auth-mask {
  align-items: center;
  justify-content: center;
  padding: 42rpx;
  background: rgba(15, 23, 42, 0.52);
  backdrop-filter: blur(8rpx);
  box-sizing: border-box;
}

.avatar-auth-sheet {
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  border-radius: 30rpx;
  box-shadow: 0 30rpx 80rpx rgba(15, 23, 42, 0.18);
}

.avatar-auth-sheet::before {
  content: "";
  display: block;
  width: 72rpx;
  height: 8rpx;
  margin: -10rpx auto 26rpx;
  border-radius: 999rpx;
  background: #dbe3ef;
}

.avatar-auth-app,
.avatar-auth-line {
  padding: 18rpx;
  border: 1rpx solid #edf2f7;
  border-radius: 18rpx;
  background: #f8fafc;
}

.avatar-auth-line {
  margin-top: 22rpx;
  border-top: 1rpx solid #edf2f7;
  border-bottom: 1rpx solid #edf2f7;
}

.avatar-auth-cancel,
.avatar-auth-confirm {
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 18rpx;
  font-weight: 800;
}

.avatar-auth-cancel {
  background: #f8fafc;
  color: #334155;
}

.avatar-auth-confirm {
  background: linear-gradient(135deg, #16a34a, #059669);
  box-shadow: 0 12rpx 24rpx rgba(22, 163, 74, 0.2);
}

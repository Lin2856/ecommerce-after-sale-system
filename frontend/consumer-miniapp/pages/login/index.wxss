.page {
  min-height: 100vh;
  padding: 82rpx 40rpx 40rpx;
  background: linear-gradient(180deg, #eef5ff 0%, #f6f8fb 42%, #f6f8fb 100%);
  box-sizing: border-box;
}

.login-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 34rpx 10rpx 42rpx;
}

.brand-icon {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(31, 122, 224, 0.24);
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 700;
}

.login-card {
  padding: 34rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e6edf7;
  box-shadow: 0 18rpx 46rpx rgba(15, 23, 42, 0.07);
  box-sizing: border-box;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.title {
  margin: 0;
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
}

.muted {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.45;
}

.secure-badge {
  flex-shrink: 0;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf3;
  color: #16a34a;
  font-size: 23rpx;
  font-weight: 800;
}

.demo-box {
  margin-top: 26rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f8fbff;
  border: 1rpx solid #e7eef8;
}

.demo-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 42rpx;
}

.demo-row + .demo-row {
  margin-top: 10rpx;
}

.demo-label {
  flex-shrink: 0;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 700;
}

.demo-value {
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 800;
  text-align: right;
}

.form-area {
  margin-top: 26rpx;
}

.input-wrap {
  padding: 18rpx 22rpx;
  border: 1rpx solid #d8e4f3;
  border-radius: 20rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.input-wrap + .input-wrap {
  margin-top: 18rpx;
}

.input-label {
  display: block;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 800;
}

.input {
  width: 100%;
  height: 54rpx;
  margin-top: 4rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
}

.primary-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 28rpx 0 0;
  border-radius: 18rpx;
  background: #1f7ae0;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 28rpx rgba(31, 122, 224, 0.22);
}

.divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 26rpx 0 18rpx;
  color: #94a3b8;
  font-size: 23rpx;
}

.divider view {
  flex: 1;
  height: 1rpx;
  background: #e8eef6;
}

.wechat-btn {
  height: 84rpx;
  line-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 0;
  border: 1rpx solid #bfe6c7;
  border-radius: 18rpx;
  background: #f8fff9;
  color: #15913a;
  font-size: 29rpx;
  font-weight: 800;
}

.wechat-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 10rpx;
}

<view class="page">
  <view class="login-hero">
    <image class="brand-icon" src="/assets/brand/fusion-after-sale-icon.png" mode="aspectFill" />
    <view class="hero-copy">
      <view class="hero-title">融合电商平台售后系统</view>
      <view class="hero-subtitle">消费者服务入口</view>
    </view>
  </view>

  <view class="login-card">
    <view class="card-head">
      <view>
        <view class="title">手机号登录</view>
        <view class="muted">输入手机号和密码进入系统</view>
      </view>
      <view class="secure-badge">安全登录</view>
    </view>

    <view class="service-scope">
      <view class="scope-title">进入后可处理</view>
      <view class="scope-grid">
        <text>查看订单售后进度</text>
        <text>提交退货物流单号</text>
        <text>查看/补充商品评价</text>
        <text>申请平台介入争议</text>
      </view>
    </view>

    <view class="form-area">
      <view class="input-wrap">
        <text class="input-label">手机号</text>
        <input class="input" placeholder="请输入手机号" type="number" bindinput="onPhoneInput" />
      </view>
      <view class="input-wrap">
        <text class="input-label">密码</text>
        <input class="input" placeholder="请输入密码" password bindinput="onPasswordInput" />
      </view>
    </view>

    <button class="primary-btn" bindtap="onLogin">登录进入</button>
  </view>
</view>

<view class="page">
  <view class="login-hero">
    <image class="brand-icon" src="/assets/brand/fusion-after-sale-icon.png" mode="aspectFill" />
    <view class="hero-copy">
      <view class="hero-title">融合电商平台售后系统</view>
      <view class="hero-subtitle">消费者服务入口</view>
    </view>
  </view>

  <view class="login-card">
    <view class="card-head">
      <view>
        <view class="title">手机号登录</view>
        <view class="muted">输入手机号和验证码进入系统</view>
      </view>
      <view class="secure-badge">安全登录</view>
    </view>

    <view class="demo-box">
      <view class="demo-row">
        <text class="demo-label">演示账号</text>
        <text class="demo-value">13338907581 / 123456</text>
      </view>
      <view class="demo-row">
        <text class="demo-label">空白账号</text>
        <text class="demo-value">13338907582 / 123456</text>
      </view>
    </view>

    <view class="form-area">
      <view class="input-wrap">
        <text class="input-label">手机号</text>
        <input class="input" placeholder="请输入手机号" type="number" bindinput="onPhoneInput" />
      </view>
      <view class="input-wrap">
        <text class="input-label">验证码</text>
        <input class="input" placeholder="请输入验证码" type="number" bindinput="onCodeInput" />
      </view>
    </view>

    <button class="primary-btn" bindtap="onLogin">登录进入</button>

    <view class="divider">
      <view></view>
      <text>或</text>
      <view></view>
    </view>

    <button class="wechat-btn" bindtap="onWechatLogin">
      <image class="wechat-icon" src="/assets/platforms/wechat.png" mode="aspectFill" />
      <text>微信一键登录</text>
    </button>
  </view>
</view>

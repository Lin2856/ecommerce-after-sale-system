.product-main {
  text-align: center;
}

.product-image {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  margin-bottom: 26rpx;
}

.price-large {
  color: #1f7ae0;
  font-size: 48rpx;
  font-weight: 800;
  margin-top: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.info-row text:last-child {
  flex: 1;
  text-align: right;
  word-break: break-all;
}

.info-row:last-child {
  border-bottom: 0;
}

.desc {
  line-height: 1.7;
  margin-top: 12rpx;
}

.feature-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.policy-block {
  padding-top: 18rpx;
}

.policy-title {
  margin-bottom: 14rpx;
}

.policy-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.policy-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf3;
  color: #039855;
  font-size: 24rpx;
}

.primary-btn,
.contact-btn {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.primary-btn {
  background: #1f7ae0;
  color: #fff;
}

.contact-btn {
  background: #eef4ff;
  color: #1f7ae0;
}

.modify-after-sale-btn {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #eef4ff;
  color: #1f7ae0;
  font-size: 30rpx;
  font-weight: 700;
}

.review-btn {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #fff7e8;
  color: #d46b08;
  font-size: 30rpx;
  font-weight: 700;
}

.review-btn-view {
  background: #eef4ff;
  color: #1f7ae0;
}

.review-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.42);
}

.after-sale-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.42);
}

.reason-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.42);
}

.reason-dialog {
  width: 100%;
  padding: 34rpx;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
}

.reason-subtitle {
  margin-top: 10rpx;
  color: #667085;
  font-size: 26rpx;
}

.reason-textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e4e7ec;
  background: #f9fafb;
  color: #101828;
  font-size: 27rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.upload-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
}

.upload-btn {
  width: 180rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin: 0;
  border-radius: 14rpx;
  background: #eef4ff;
  color: #1f7ae0;
  font-size: 26rpx;
  font-weight: 700;
}

.upload-tip {
  flex: 1;
  color: #98a2b3;
  font-size: 24rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.image-item {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f2f4f7;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-item text {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(16, 24, 40, 0.68);
  color: #fff;
  font-size: 30rpx;
}

.image-item.readonly text {
  display: none;
}

.after-sale-dialog {
  width: 100%;
  max-height: 86vh;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
  overflow-y: auto;
}

.after-sale-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.after-sale-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.after-sale-close {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  border-radius: 50%;
  background: #f2f4f7;
  color: #667085;
  text-align: center;
  font-size: 38rpx;
  font-weight: 700;
}

.after-sale-summary {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.after-sale-product-image {
  width: 108rpx;
  height: 108rpx;
  border-radius: 14rpx;
  background: #eef2f7;
}

.after-sale-product-main {
  flex: 1;
  min-width: 0;
}

.after-sale-product-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.after-sale-product-no {
  margin-top: 10rpx;
  color: #667085;
  font-size: 23rpx;
  word-break: break-all;
}

.after-sale-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
  font-size: 27rpx;
}

.after-sale-row text:last-child {
  flex: 1;
  text-align: right;
}

.after-sale-tip {
  margin: 24rpx 0;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.6;
}

.after-sale-images {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.return-shipping-block {
  margin-top: 28rpx;
  padding: 26rpx;
  border: 1rpx solid #bfdbfe;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #eff6ff 0%, #f8fbff 100%);
}

.return-title {
  color: #101828;
  font-size: 30rpx;
  font-weight: 800;
}

.return-tip {
  margin-top: 10rpx;
  color: #475569;
  font-size: 25rpx;
  line-height: 1.6;
}

.return-input {
  height: 82rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border: 1rpx solid #bfdbfe;
  border-radius: 14rpx;
  background: #fff;
  color: #101828;
  font-size: 28rpx;
  box-sizing: border-box;
}

.return-submit {
  height: 82rpx;
  line-height: 82rpx;
  margin-top: 16rpx;
  border-radius: 14rpx;
  background: #1f7ae0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.dispute-entry {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
}

.dispute-entry-title {
  color: #9a3412;
  font-size: 28rpx;
  font-weight: 800;
}

.dispute-submit {
  height: 76rpx;
  line-height: 76rpx;
  margin-top: 18rpx;
  border-radius: 14rpx;
  background: #ea580c;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
}

.dispute-submit.disabled {
  background: #e5e7eb;
  color: #667085;
}

.detail-close-btn {
  height: 76rpx;
  line-height: 76rpx;
  margin-top: 18rpx;
  border-radius: 14rpx;
  background: #f2f4f7;
  color: #344054;
  font-size: 27rpx;
  font-weight: 700;
}

.review-dialog {
  width: 100%;
  padding: 34rpx;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
}

.review-title {
  color: #101828;
  font-size: 34rpx;
  font-weight: 800;
}

.review-merchant {
  margin-top: 8rpx;
  color: #667085;
  font-size: 26rpx;
}

.review-detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.review-detail-close {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  border-radius: 50%;
  background: #f2f4f7;
  color: #667085;
  text-align: center;
  font-size: 38rpx;
  font-weight: 700;
}

.review-detail-summary {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.review-detail-product {
  color: #101828;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}

.review-detail-meta {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.review-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eef2f7;
}

.review-section-title {
  color: #344054;
  font-size: 28rpx;
  font-weight: 700;
}

.star-row {
  display: flex;
  gap: 14rpx;
  margin: 18rpx 0;
}

.star {
  color: #d0d5dd;
  font-size: 52rpx;
  line-height: 1;
}

.star-active {
  color: #f79009;
}

.readonly-stars {
  margin-bottom: 12rpx;
}

.readonly-stars .star {
  font-size: 42rpx;
}

.review-detail-content {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  color: #344054;
  font-size: 27rpx;
  line-height: 1.7;
}

.review-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e4e7ec;
  background: #f9fafb;
  color: #101828;
  font-size: 27rpx;
  box-sizing: border-box;
}

.review-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.review-cancel,
.review-submit {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.review-cancel {
  background: #f2f4f7;
  color: #344054;
}

.review-submit {
  background: #1f7ae0;
  color: #fff;
}

.review-mask,
.after-sale-mask,
.reason-mask {
  background: rgba(15, 23, 42, 0.52);
  backdrop-filter: blur(8rpx);
}

.reason-dialog,
.review-dialog,
.after-sale-dialog {
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  border-radius: 30rpx;
  box-shadow: 0 30rpx 80rpx rgba(15, 23, 42, 0.18);
}

.reason-dialog::before,
.review-dialog::before,
.after-sale-dialog::before {
  content: "";
  display: block;
  width: 72rpx;
  height: 8rpx;
  margin: -8rpx auto 24rpx;
  border-radius: 999rpx;
  background: #dbe3ef;
}

.reason-textarea,
.review-textarea,
.return-input {
  border-color: #dbe3ef;
  border-radius: 18rpx;
  background: #fbfdff;
}

.after-sale-summary,
.review-detail-summary {
  border: 1rpx solid #edf2f7;
  background: linear-gradient(135deg, #f8fafc, #ffffff);
}

.after-sale-row {
  align-items: flex-start;
}

.after-sale-row text:first-child {
  color: #64748b;
  font-weight: 700;
}

.after-sale-row text:last-child {
  color: #0f172a;
  font-weight: 700;
}

.review-cancel,
.review-submit,
.detail-close-btn,
.dispute-submit,
.return-submit,
.upload-btn {
  border-radius: 18rpx;
  font-weight: 800;
}

.review-submit,
.return-submit {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  box-shadow: 0 12rpx 24rpx rgba(37, 99, 235, 0.22);
}

.review-cancel,
.detail-close-btn {
  background: #f8fafc;
  color: #334155;
}

.dispute-entry {
  background: linear-gradient(135deg, #fff7ed, #ffffff);
}

.image-item,
.evidence-image {
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.08);
}

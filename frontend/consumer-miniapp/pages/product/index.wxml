<view class="page" wx:if="{{product}}">
  <view class="product-main card">
    <image class="product-image" src="{{product.image}}" mode="aspectFit" />
    <view class="title">{{product.title}}</view>
    <view class="muted">{{product.spec}}</view>
    <view class="price-large">￥{{product.price}}</view>
  </view>

  <view class="card">
    <view class="sub-title">订单信息</view>
    <view class="info-row">
      <text class="muted">订单编号</text>
      <text>{{product.no}}</text>
    </view>
    <view class="info-row">
      <text class="muted">平台来源</text>
      <text>{{product.platform}}</text>
    </view>
    <view class="info-row">
      <text class="muted">商家名称</text>
      <text>{{product.merchant}}</text>
    </view>
    <view class="info-row">
      <text class="muted">订单状态</text>
      <text>{{product.status}}</text>
    </view>
    <view class="info-row" wx:if="{{product.orderedAt}}">
      <text class="muted">下单时间</text>
      <text>{{product.orderedAt}}</text>
    </view>
    <view class="info-row" wx:if="{{product.deliveredAt}}">
      <text class="muted">到货时间</text>
      <text>{{product.deliveredAt}}</text>
    </view>
    <view class="info-row">
      <text class="muted">售后状态</text>
      <text>{{product.afterSale}}</text>
    </view>
    <view class="policy-block" wx:if="{{product.policyTags && product.policyTags.length}}">
      <view class="muted policy-title">售后政策</view>
      <view class="policy-tags">
        <view wx:for="{{product.policyTags}}" wx:key="index" class="policy-tag">{{item}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="sub-title">商品描述</view>
    <view class="muted desc">{{product.description}}</view>
    <view class="feature-list">
      <view wx:for="{{product.features}}" wx:key="index" class="tag">{{item}}</view>
    </view>
  </view>

  <button class="primary-btn" bindtap="handleAfterSalePrimary">
    {{product.afterSale && product.afterSale !== '未申请' ? '查看售后详细' : '申请售后'}}
  </button>
  <button
    wx:if="{{product.afterSale && product.afterSale !== '未申请'}}"
    class="modify-after-sale-btn"
    bindtap="modifyAfterSale"
  >修改售后信息</button>
  <button class="contact-btn" bindtap="contactMerchant">联系商家</button>
  <button class="review-btn {{product.reviewed ? 'review-btn-disabled' : ''}}" bindtap="openReviewDialog">
    {{product.reviewed ? '已评价' : '评价商家'}}
  </button>

  <view wx:if="{{reasonDialogVisible}}" class="reason-mask">
    <view class="reason-dialog">
      <view class="review-title">填写申请原因</view>
      <view class="reason-subtitle">请说明申请{{reasonForm.type}}的具体原因</view>
      <textarea
        class="reason-textarea"
        placeholder="例如：商品破损、功能异常、未收到货等"
        maxlength="200"
        value="{{reasonText}}"
        bindinput="onReasonInput"
      />
      <view class="upload-row">
        <button class="upload-btn" bindtap="chooseReasonImage">上传照片</button>
        <text class="upload-tip">最多3张，用于辅助商家审核</text>
      </view>
      <view class="image-list" wx:if="{{reasonImages.length}}">
        <view wx:for="{{reasonImages}}" wx:key="index" class="image-item">
          <image src="{{item}}" mode="aspectFill" />
          <text data-index="{{index}}" bindtap="removeReasonImage">×</text>
        </view>
      </view>
      <view class="review-actions">
        <button class="review-cancel" bindtap="closeReasonDialog">取消</button>
        <button class="review-submit" bindtap="submitReasonDialog">提交</button>
      </view>
    </view>
  </view>

  <view wx:if="{{afterSaleDetailVisible}}" class="after-sale-mask">
    <view class="after-sale-dialog">
      <view class="after-sale-header">
        <view>
          <view class="review-title">售后详情</view>
          <view class="after-sale-subtitle">{{product.platform}} · {{product.merchant}}</view>
        </view>
        <text class="after-sale-close" bindtap="closeAfterSaleDetail">×</text>
      </view>
      <view class="after-sale-summary">
        <image class="after-sale-product-image" src="{{product.image}}" mode="aspectFill" />
        <view class="after-sale-product-main">
          <view class="after-sale-product-title">{{product.title}}</view>
          <view class="after-sale-product-no">订单编号：{{product.no}}</view>
        </view>
      </view>
      <view class="after-sale-row">
        <text class="muted">售后类型</text>
        <text>{{afterSaleDetail.type || '退货退款'}}</text>
      </view>
      <view class="after-sale-row">
        <text class="muted">售后状态</text>
        <text>{{afterSaleDetail.status === '商家已同意退款，请寄回商品' ? '商家已同意退款，请寄回商品' : product.afterSale}}</text>
      </view>
      <view class="after-sale-row" wx:if="{{afterSaleDetail.returnTrackingNo}}">
        <text class="muted">退货单号</text>
        <text>{{afterSaleDetail.returnTrackingNo}}</text>
      </view>
      <view class="after-sale-row" wx:if="{{afterSaleDetail.returnShippedAt}}">
        <text class="muted">寄回时间</text>
        <text>{{afterSaleDetail.returnShippedAt}}</text>
      </view>
      <view class="after-sale-row" wx:if="{{afterSaleDetail.reason}}">
        <text class="muted">申请原因</text>
        <text>{{afterSaleDetail.reason}}</text>
      </view>
      <view class="after-sale-images" wx:if="{{afterSaleDetail.evidenceImages && afterSaleDetail.evidenceImages.length}}">
        <view class="muted">凭证照片</view>
        <view class="image-list">
          <view wx:for="{{afterSaleDetail.evidenceImages}}" wx:key="index" class="image-item readonly">
            <image src="{{item}}" mode="aspectFill" />
          </view>
        </view>
      </view>
      <view class="after-sale-row">
        <text class="muted">申请时间</text>
        <text>{{afterSaleDetail.appliedAt || '2026.6.29 10:35:23'}}</text>
      </view>
      <view wx:if="{{afterSaleDetail.status !== '商家已同意退款，请寄回商品'}}" class="after-sale-tip">售后申请已提交，商家将在后台审核并处理。你可以返回本页修改售后类型。</view>
      <view wx:if="{{afterSaleDetail.status === '已拒绝' && afterSaleDetail.type !== '价保'}}" class="dispute-entry">
        <view class="dispute-entry-title">对商家处理结果有异议？</view>
        <view class="return-tip">你可以填写二次售后表单并联系平台处理，平台管理员将结合双方材料进行裁决。</view>
        <button class="dispute-submit" bindtap="openDisputeDialog">申请平台介入</button>
      </view>
      <button wx:if="{{afterSaleDetail.status !== '商家已同意退款，请寄回商品'}}" class="detail-close-btn" bindtap="closeAfterSaleDetail">知道了</button>
      <view wx:if="{{afterSaleDetail.status === '商家已同意退款，请寄回商品'}}" class="return-shipping-block">
        <view class="return-title">寄回商品</view>
        <view class="return-tip">商家已同意本次退货退款申请。</view>
        <view class="return-tip">请在寄回商品后填写退货快递单号，商家收到商品并验收后会继续处理退款。</view>
        <input
          class="return-input"
          placeholder="请输入退货快递单号"
          value="{{returnTrackingNo}}"
          bindinput="onReturnTrackingInput"
        />
        <button class="return-submit" bindtap="submitReturnTracking">提交快递单号</button>
      </view>
    </view>
  </view>

  <view wx:if="{{disputeDialogVisible}}" class="reason-mask">
    <view class="reason-dialog">
      <view class="review-title">申请平台介入</view>
      <view class="reason-subtitle">请说明你不同意商家处理结果的原因，平台管理员将进行人工审核。</view>
      <textarea
        class="reason-textarea"
        placeholder="例如：商品确实存在质量问题，商家拒绝理由不合理，希望平台介入处理"
        maxlength="300"
        value="{{disputeReasonText}}"
        bindinput="onDisputeReasonInput"
      />
      <view class="upload-row">
        <button class="upload-btn" bindtap="chooseDisputeImage">上传照片</button>
        <text class="upload-tip">最多3张，用于平台审核</text>
      </view>
      <view class="image-list" wx:if="{{disputeImages.length}}">
        <view wx:for="{{disputeImages}}" wx:key="index" class="image-item">
          <image src="{{item}}" mode="aspectFill" />
          <text data-index="{{index}}" bindtap="removeDisputeImage">×</text>
        </view>
      </view>
      <view class="review-actions">
        <button class="review-cancel" bindtap="closeDisputeDialog">取消</button>
        <button class="review-submit" bindtap="submitDisputeDialog">提交平台介入</button>
      </view>
    </view>
  </view>

  <view wx:if="{{reviewVisible}}" class="review-mask">
    <view class="review-dialog">
      <view class="review-title">订单评价</view>
      <view class="review-merchant">{{product.merchant}}</view>
      <view class="review-section">
        <view class="review-section-title">产品质量评价</view>
        <view class="star-row">
          <text
            wx:for="{{productReviewStars}}"
            wx:key="value"
            data-score="{{item.value}}"
            class="star {{item.active ? 'star-active' : ''}}"
            bindtap="setProductReviewScore"
          >★</text>
        </view>
        <textarea
          class="review-textarea"
          placeholder="请描述商品质量、包装、使用体验等情况"
          maxlength="200"
          value="{{productReviewText}}"
          bindinput="onProductReviewInput"
        />
      </view>
      <view class="review-section">
        <view class="review-section-title">商家服务评价</view>
        <view class="star-row">
          <text
            wx:for="{{merchantReviewStars}}"
            wx:key="value"
            data-score="{{item.value}}"
            class="star {{item.active ? 'star-active' : ''}}"
            bindtap="setMerchantReviewScore"
          >★</text>
        </view>
        <textarea
          class="review-textarea"
          placeholder="请描述商家沟通、响应速度、售后服务等体验"
          maxlength="200"
          value="{{merchantReviewText}}"
          bindinput="onMerchantReviewInput"
        />
      </view>
      <view class="review-actions">
        <button class="review-cancel" bindtap="closeReviewDialog">取消</button>
        <button class="review-submit" bindtap="submitReview">提交评价</button>
      </view>
    </view>
  </view>
</view>

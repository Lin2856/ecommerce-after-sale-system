<view class="page">
  <view class="profile-card">
    <view class="profile-top">
      <image wx:if="{{profile.avatar}}" class="avatar" src="{{profile.avatar}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-empty"></view>
      <view class="profile-main">
        <view class="title">{{profile.nickname || '未设置昵称'}}</view>
        <view class="phone">{{profile.phone || '未登录'}}</view>
      </view>
    </view>
    <view class="status-strip">
      <view class="status-item">
        <text class="status-label">账号状态</text>
        <text class="status-value">正常</text>
      </view>
      <view class="status-line"></view>
      <view class="status-item">
        <text class="status-label">平台绑定</text>
        <text class="status-value">{{profile.bindPlatform}}</text>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <view class="sub-title">个人信息</view>
      <button class="edit-btn" bindtap="editProfile">修改</button>
    </view>
    <view class="info-grid">
      <view class="info-cell">
        <text class="muted">昵称</text>
        <text class="info-value">{{profile.nickname || '未设置'}}</text>
      </view>
      <view class="info-cell">
        <text class="muted">电话号码</text>
        <text class="info-value">{{profile.phone || '暂无'}}</text>
      </view>
      <view class="info-cell wide">
        <text class="muted">最近咨询</text>
        <text class="info-value">{{profile.lastConsult}}</text>
      </view>
    </view>
  </view>

  <view class="section-card address-card" bindtap="manageAddress">
    <view class="between">
      <view class="address-main">
        <view class="sub-title">地址管理</view>
        <view class="address">{{profile.address || '暂未添加地址'}}</view>
      </view>
      <view class="address-action">
        <text>管理</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="account-actions section-card">
    <view class="sub-title">账号操作</view>
    <button class="logout-btn" bindtap="logout">退出登录</button>
    <button class="cancel-account-btn" bindtap="openCancelAccountDialog">注销账号</button>
  </view>

  <view wx:if="{{cancelDialogVisible}}" class="dialog-mask">
    <view class="cancel-dialog">
      <view class="dialog-title">注销账号</view>
      <view class="dialog-warning">该操作会永久删除当前一级账号在本机保存的资料、地址、电商平台绑定和登录状态，删除后不可恢复。</view>
      <view class="dialog-hint">请仔细阅读 5 秒后再确认是否继续。</view>
      <view class="dialog-actions">
        <button class="dialog-cancel-btn" bindtap="closeCancelAccountDialog">取消</button>
        <button
          class="dialog-confirm-btn {{cancelConfirmEnabled ? '' : 'dialog-confirm-disabled'}}"
          bindtap="confirmCancelAccount"
        >
          {{cancelConfirmEnabled ? '确认注销' : '确认注销(' + cancelCountdown + 's)'}}
        </button>
      </view>
    </view>
  </view>
</view>

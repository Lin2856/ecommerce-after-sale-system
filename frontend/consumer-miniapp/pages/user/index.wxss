.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 34rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.profile-card {
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7fbff 100%);
  border: 1rpx solid #e6edf7;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.05);
  box-sizing: border-box;
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  width: 122rpx;
  height: 122rpx;
  border-radius: 34rpx;
  flex-shrink: 0;
  background: #eef2f7;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.08);
}

.avatar-empty {
  background: #eef2f7;
  border: 1rpx dashed #cbd5e1;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.title {
  margin: 0;
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 600;
}

.edit-btn {
  width: 112rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 800;
}

.status-strip {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid #edf2f7;
}

.status-item {
  flex: 1;
  min-width: 0;
}

.status-label {
  display: block;
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 700;
}

.status-value {
  display: block;
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-line {
  width: 1rpx;
  height: 54rpx;
  margin: 0 22rpx;
  background: #e6edf7;
}

.section-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #e8eef6;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.035);
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.sub-title {
  color: #0f172a;
  font-size: 31rpx;
  font-weight: 900;
}

.section-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #2563eb;
  box-shadow: 0 0 0 8rpx #eff6ff;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.info-cell {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.info-cell.wide {
  width: 100%;
}

.muted {
  display: block;
  color: #64748b;
  font-size: 24rpx;
}

.info-value {
  display: block;
  margin-top: 10rpx;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.address-card {
  padding: 30rpx 28rpx;
}

.between {
  align-items: center;
}

.address-main {
  flex: 1;
  min-width: 0;
}

.address {
  margin-top: 12rpx;
  max-width: 510rpx;
  color: #475569;
  font-size: 27rpx;
  line-height: 1.45;
}

.address-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #2563eb;
  font-size: 25rpx;
  font-weight: 800;
}

.arrow {
  color: #94a3b8;
  font-size: 38rpx;
  line-height: 1;
}

.account-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 28rpx;
  margin-bottom: 14rpx;
}

.account-actions .sub-title {
  width: 100%;
  margin-bottom: 2rpx;
}

.logout-btn,
.cancel-account-btn {
  flex: 1;
  min-width: 0;
  height: 82rpx;
  line-height: 82rpx;
  margin: 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.logout-btn {
  background: #eff6ff;
  color: #2563eb;
}

.cancel-account-btn {
  background: #fef2f2;
  color: #d92d20;
}

.dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.42);
}

.cancel-dialog {
  width: 100%;
  padding: 36rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #101828;
  margin-bottom: 18rpx;
}

.dialog-warning {
  color: #d92d20;
  font-size: 27rpx;
  line-height: 1.65;
}

.dialog-hint {
  margin-top: 18rpx;
  color: #667085;
  font-size: 25rpx;
}

.dialog-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.dialog-cancel-btn,
.dialog-confirm-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
}

.dialog-cancel-btn {
  background: #f2f4f7;
  color: #344054;
}

.dialog-confirm-btn {
  background: #d92d20;
  color: #ffffff;
}

.dialog-confirm-disabled {
  background: #f2b8b5;
  color: #ffffff;
}

.dialog-mask {
  background: rgba(15, 23, 42, 0.52);
  backdrop-filter: blur(8rpx);
}

.cancel-dialog {
  padding: 38rpx;
  border: 1rpx solid rgba(254, 202, 202, 0.86);
  border-radius: 30rpx;
  box-shadow: 0 30rpx 80rpx rgba(15, 23, 42, 0.18);
}

.cancel-dialog::before {
  content: "";
  display: block;
  width: 72rpx;
  height: 8rpx;
  margin: -10rpx auto 26rpx;
  border-radius: 999rpx;
  background: #fecaca;
}

.dialog-warning {
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fef2f2;
  border: 1rpx solid #fee2e2;
}

.dialog-cancel-btn,
.dialog-confirm-btn {
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 18rpx;
  font-weight: 800;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-sticky {
  flex-shrink: 0;
  z-index: 8;
  padding-top: 4rpx;
  padding-bottom: 12rpx;
  background: #f5f7fb;
}

.consult-order {
  margin-bottom: 10rpx;
  padding: 20rpx;
}

.consult-main {
  display: flex;
  align-items: center;
}

.consult-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #eaf2ff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.consult-info {
  flex: 1;
  min-width: 0;
}

.consult-title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.consult-title-row .sub-title {
  flex: 1;
  min-width: 0;
  line-height: 1.25;
}

.status-pill {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #1f7ae0;
  font-size: 22rpx;
  font-weight: 700;
}

.order-no {
  margin-top: 4rpx;
  color: #7b8798;
}

.consult-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.consult-action {
  flex: 1;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d0d5dd;
  background: #ffffff;
  color: #344054;
  font-size: 26rpx;
  font-weight: 600;
}

.consult-action-primary {
  border-color: #1f7ae0;
  background: #1f7ae0;
  color: #ffffff;
}

.consult-action::after {
  border: 0;
}

.chat-list {
  flex: 1;
  min-height: 0;
  padding-bottom: 0;
  box-sizing: border-box;
}

.chat-bottom-spacer {
  height: 28rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.msg-right {
  justify-content: flex-end;
  margin-left: auto;
  text-align: right;
}

.msg-left {
  justify-content: flex-start;
  margin-right: auto;
}

.msg-body {
  max-width: 78%;
}

.speaker {
  color: #667085;
  font-size: 21rpx;
  margin-bottom: 6rpx;
}

.speaker text {
  margin-left: 10rpx;
  color: #98a2b3;
  font-size: 20rpx;
}

.bubble {
  display: inline-block;
  background: #ffffff;
  border: 1rpx solid #eef2f7;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
  text-align: left;
}

.bubble-user {
  background: #1f7ae0;
  color: #ffffff;
  border-color: #1f7ae0;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 20rpx;
  font-weight: 800;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar image {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-service {
  background: #eef4ff;
  color: #1f7ae0;
}

.avatar-ai {
  background: #ecfdf3;
  color: #079455;
}

.avatar-user {
  background: #f2f4f7;
  color: #344054;
}

.input-card {
  position: relative;
  left: auto;
  right: auto;
  bottom: auto;
  flex-shrink: 0;
  margin: 4rpx -24rpx 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #ffffff;
  border-top: 1rpx solid #eef2f7;
  border-radius: 0;
  padding: 12rpx 24rpx 10rpx;
  box-sizing: border-box;
}

.input-card input {
  flex: 1;
  height: 66rpx;
}

.send-btn {
  width: 136rpx;
  height: 66rpx;
  line-height: 66rpx;
  background: #1f7ae0;
  color: #fff;
  border-radius: 12rpx;
}

.empty-card {
  background: #ffffff;
  border: 1rpx solid #eef2f7;
  border-radius: 18rpx;
  padding: 48rpx 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #101828;
  margin-bottom: 12rpx;
}

.empty-text {
  color: #667085;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.empty-btn {
  width: 220rpx;
  background: #1f7ae0;
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 28rpx;
}

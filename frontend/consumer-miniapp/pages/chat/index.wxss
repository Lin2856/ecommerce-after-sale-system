.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 250rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-sticky {
  flex-shrink: 0;
  z-index: 8;
  padding-top: 4rpx;
  padding-bottom: 12rpx;
  background: #f5f7fb;
}

.consult-order {
  margin-bottom: 10rpx;
  padding: 20rpx;
}

.consult-main {
  display: flex;
  align-items: center;
}

.consult-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #eaf2ff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.consult-info {
  flex: 1;
  min-width: 0;
}

.consult-title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.consult-title-row .sub-title {
  flex: 1;
  min-width: 0;
  line-height: 1.25;
}

.status-pill {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #1f7ae0;
  font-size: 22rpx;
  font-weight: 700;
}

.order-no {
  margin-top: 4rpx;
  color: #7b8798;
}

.consult-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.consult-action {
  flex: 1;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d0d5dd;
  background: #ffffff;
  color: #344054;
  font-size: 26rpx;
  font-weight: 600;
}

.consult-action-primary {
  border-color: #1f7ae0;
  background: #1f7ae0;
  color: #ffffff;
}

.consult-action::after {
  border: 0;
}

.chat-list {
  flex: 1;
  min-height: 0;
  padding-bottom: 0;
  box-sizing: border-box;
}

.chat-bottom-spacer {
  height: 28rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.msg-right {
  justify-content: flex-end;
  margin-left: auto;
  text-align: right;
}

.msg-left {
  justify-content: flex-start;
  margin-right: auto;
}

.msg-body {
  max-width: 78%;
}

.speaker {
  color: #667085;
  font-size: 21rpx;
  margin-bottom: 6rpx;
}

.speaker text {
  margin-left: 10rpx;
  color: #98a2b3;
  font-size: 20rpx;
}

.bubble {
  display: inline-block;
  background: #ffffff;
  border: 1rpx solid #eef2f7;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
  text-align: left;
}

.bubble-user {
  background: #1f7ae0;
  color: #ffffff;
  border-color: #1f7ae0;
}

.bubble-transfer-btn {
  width: 220rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin: 14rpx 0 0;
  border-radius: 12rpx;
  background: #1f7ae0;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
}

.bubble-transfer-btn::after {
  border: 0;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 20rpx;
  font-weight: 800;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar image {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-service {
  background: #eef4ff;
  color: #1f7ae0;
}

.avatar-ai {
  background: #ecfdf3;
  color: #079455;
}

.avatar-user {
  background: #f2f4f7;
  color: #344054;
}

.input-card {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 146rpx);
  z-index: 900;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e4eaf2;
  border-radius: 24rpx;
  padding: 12rpx 14rpx 12rpx 22rpx;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.1);
  box-sizing: border-box;
}

.input-card input {
  flex: 1;
  height: 66rpx;
}

.send-btn {
  width: 136rpx;
  height: 66rpx;
  line-height: 66rpx;
  background: #1f7ae0;
  color: #fff;
  border-radius: 12rpx;
}

.order-switcher-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.42);
}

.order-switcher-panel {
  width: 100%;
  max-height: 72vh;
  padding: 28rpx 24rpx calc(env(safe-area-inset-bottom) + 28rpx);
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.order-switcher-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.order-switcher-title {
  color: #101828;
  font-size: 32rpx;
  font-weight: 800;
}

.order-switcher-subtitle {
  margin-top: 6rpx;
  color: #667085;
  font-size: 24rpx;
}

.order-switcher-close {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  padding: 0;
  border-radius: 50%;
  background: #f2f4f7;
  color: #667085;
  font-size: 38rpx;
}

.order-switcher-close::after {
  border: 0;
}

.order-switcher-list {
  max-height: 58vh;
}

.order-switcher-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid #e4eaf2;
  border-radius: 18rpx;
  background: #ffffff;
}

.order-switcher-item.active {
  border-color: #1f7ae0;
  background: #eef6ff;
}

.order-switcher-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 14rpx;
  background: #eaf2ff;
  flex-shrink: 0;
}

.order-switcher-info {
  flex: 1;
  min-width: 0;
}

.order-switcher-name {
  overflow: hidden;
  color: #101828;
  font-size: 28rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-switcher-meta {
  margin-top: 4rpx;
  overflow: hidden;
  color: #667085;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-switcher-status {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #1f7ae0;
  font-size: 22rpx;
  font-weight: 700;
}

.empty-card {
  background: #ffffff;
  border: 1rpx solid #eef2f7;
  border-radius: 18rpx;
  padding: 48rpx 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #101828;
  margin-bottom: 12rpx;
}

.empty-text {
  color: #667085;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.empty-btn {
  width: 220rpx;
  background: #1f7ae0;
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.order-switcher-mask {
  align-items: center;
  justify-content: center;
  padding: 42rpx;
  background: rgba(15, 23, 42, 0.52);
  backdrop-filter: blur(8rpx);
  box-sizing: border-box;
}

.order-switcher-panel {
  max-height: 78vh;
  padding: 34rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  border-radius: 30rpx;
  box-shadow: 0 30rpx 80rpx rgba(15, 23, 42, 0.18);
}

.order-switcher-panel::before {
  content: "";
  display: block;
  width: 72rpx;
  height: 8rpx;
  margin: -8rpx auto 24rpx;
  border-radius: 999rpx;
  background: #dbe3ef;
}

.order-switcher-item {
  border-color: #edf2f7;
  border-radius: 20rpx;
  background: #fbfdff;
}

.order-switcher-item.active {
  border-color: #2563eb;
  background: #eff6ff;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.12);
}

.order-switcher-close {
  background: #f8fafc;
  color: #334155;
}

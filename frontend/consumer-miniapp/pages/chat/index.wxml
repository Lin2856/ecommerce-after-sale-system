<view class="page">
  <view wx:if="{{!platformBound}}" class="empty-card">
    <view class="empty-title">请先绑定电商平台</view>
    <view class="empty-text">绑定平台账号后，客服会根据对应订单进行 AI 或人工对话。</view>
    <button class="empty-btn" bindtap="goBind">去绑定</button>
  </view>

  <block wx:else>
  <view class="chat-sticky">
    <view class="consult-order card">
      <view class="consult-main">
        <image class="consult-thumb" src="{{consultingOrder.image}}" mode="aspectFill" />
        <view class="consult-info">
          <view class="consult-title-row">
            <view class="sub-title">{{consultingOrder.title}}</view>
            <view class="status-pill">{{consultingOrder.afterSale}}</view>
          </view>
          <view class="muted order-no">订单编号：{{consultingOrder.no}}</view>
          <view class="muted">商家：{{consultingOrder.merchant}}</view>
        </view>
      </view>
      <view class="consult-actions">
        <button class="consult-action consult-action-primary" bindtap="goOrderDetail">查看订单</button>
        <button class="consult-action" bindtap="openOrderSwitcher">切换订单</button>
      </view>
    </view>
  </view>

  <scroll-view
    class="chat-list"
    scroll-y
    scroll-with-animation
    scroll-top="{{scrollTop}}"
    scroll-into-view="{{scrollTarget}}"
  >
    <view wx:for="{{displayMessages}}" wx:key="index" class="msg-row {{item.role === 'user' ? 'msg-right' : 'msg-left'}}">
      <view wx:if="{{item.role !== 'user'}}" class="avatar avatar-service {{item.role === 'ai' ? 'avatar-ai' : ''}}">
        <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
        <text wx:else>{{item.avatarText}}</text>
      </view>
      <view class="msg-body">
        <view class="speaker">{{item.speaker}}<text>{{item.time}}</text></view>
        <view class="bubble {{item.role === 'user' ? 'bubble-user' : ''}}">
          {{item.content}}
        </view>
        <button
          wx:if="{{item.showTransfer && mode !== '人工'}}"
          class="bubble-transfer-btn"
          data-order-no="{{activeOrderNo}}"
          bindtap="transferFromAiMessage"
        >转人工客服</button>
      </view>
      <view wx:if="{{item.role === 'user'}}" class="avatar avatar-user">
        <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
        <text wx:else>{{item.avatarText}}</text>
      </view>
    </view>
    <view id="chat-bottom" class="chat-bottom-spacer"></view>
  </scroll-view>

  <view class="input-card">
    <input value="{{inputValue}}" bindinput="onInput" placeholder="输入消息，发送“转人工”可接入人工客服" />
    <button class="send-btn" bindtap="sendMessage">发送</button>
  </view>

  <view wx:if="{{orderSwitcherVisible}}" class="order-switcher-mask" bindtap="closeOrderSwitcher">
    <view class="order-switcher-panel" catchtap="noop">
      <view class="order-switcher-head">
        <view>
          <view class="order-switcher-title">切换咨询订单</view>
          <view class="order-switcher-subtitle">选择后将进入对应订单的客服会话</view>
        </view>
        <button class="order-switcher-close" bindtap="closeOrderSwitcher">×</button>
      </view>
      <scroll-view class="order-switcher-list" scroll-y>
        <view
          wx:for="{{orders}}"
          wx:key="no"
          class="order-switcher-item {{item.no === activeOrderNo ? 'active' : ''}}"
          data-no="{{item.no}}"
          bindtap="switchOrder"
        >
          <image class="order-switcher-thumb" src="{{item.image}}" mode="aspectFill" />
          <view class="order-switcher-info">
            <view class="order-switcher-name">{{item.title}}</view>
            <view class="order-switcher-meta">订单编号：{{item.no}}</view>
            <view class="order-switcher-meta">商家：{{item.merchant}}</view>
          </view>
          <view class="order-switcher-status">{{item.no === activeOrderNo ? '当前' : item.afterSale}}</view>
        </view>
      </scroll-view>
    </view>
  </view>
  </block>
</view>
